MAINTAINERFLOW_ENVIRONMENT=development
MAINTAINERFLOW_LOG_LEVEL=INFO
MAINTAINERFLOW_GITHUB_APP_ID=123456
MAINTAINERFLOW_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Keep false until the GitHub App is configured. Workflow=true requires the full private key.
MAINTAINERFLOW_WORKFLOW_ENABLED=false
MAINTAINERFLOW_CHECK_PUBLISH_ENABLED=false
# PEM private key on one line with literal \n characters; wrap the value in double quotes.
MAINTAINERFLOW_GITHUB_PRIVATE_KEY=
MAINTAINERFLOW_GITHUB_API_URL=https://api.github.com
MAINTAINERFLOW_GITHUB_API_VERSION=2026-03-10
MAINTAINERFLOW_DATABASE_URL=postgresql+asyncpg://maintainerflow:maintainerflow@db:5432/maintainerflow
MAINTAINERFLOW_REDIS_URL=redis://redis:6379/0
MAINTAINERFLOW_DELIVERY_LEASE_SECONDS=60
MAINTAINERFLOW_RECOVERY_INTERVAL_SECONDS=30
MAINTAINERFLOW_AI_ENABLED=false
MAINTAINERFLOW_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional; never commit a real value.
MAINTAINERFLOW_GEMINI_API_KEY=
MAINTAINERFLOW_AI_TIMEOUT_SECONDS=30
MAINTAINERFLOW_ANALYSIS_STORE_DIFF=false
MAINTAINERFLOW_ANALYSIS_MAX_DIFF_BYTES=1000000
# shadow is always neutral; suggestion may report LOW as success but never blocks or mutates a PR.
MAINTAINERFLOW_CHECK_MODE=shadow
MAINTAINERFLOW_ISSUE_TRIAGE_ENABLED=false
MAINTAINERFLOW_REPOSITORY_INTELLIGENCE_ENABLED=false
MAINTAINERFLOW_REPOSITORY_STORE_SOURCE_CODE=false
MAINTAINERFLOW_ISSUE_STORE_BODY=false
MAINTAINERFLOW_INTELLIGENCE_RETENTION_DAYS=30
MAINTAINERFLOW_GITHUB_HISTORY_RATE_LIMIT_FLOOR=100
MAINTAINERFLOW_OUTBOX_LEASE_SECONDS=60
MAINTAINERFLOW_OUTBOX_BATCH_SIZE=20
MAINTAINERFLOW_OUTBOX_MAX_ATTEMPTS=5

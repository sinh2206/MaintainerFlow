MAINTAINERFLOW_ENVIRONMENT=development
MAINTAINERFLOW_LOG_LEVEL=INFO
MAINTAINERFLOW_GITHUB_APP_ID=123456
MAINTAINERFLOW_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
MAINTAINERFLOW_DATABASE_URL=postgresql+asyncpg://maintainerflow:maintainerflow@db:5432/maintainerflow
MAINTAINERFLOW_REDIS_URL=redis://redis:6379/0
MAINTAINERFLOW_DELIVERY_LEASE_SECONDS=60
MAINTAINERFLOW_RECOVERY_INTERVAL_SECONDS=30
MAINTAINERFLOW_AI_ENABLED=false
MAINTAINERFLOW_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional; never commit a real value.
MAINTAINERFLOW_GEMINI_API_KEY=
MAINTAINERFLOW_AI_TIMEOUT_SECONDS=30
MAINTAINERFLOW_ANALYSIS_STORE_DIFF=false
MAINTAINERFLOW_ANALYSIS_MAX_DIFF_BYTES=1000000
